services:
  app:
    image: nestjs-app:latest
    build:
      context: .
      target: production
    restart: unless-stopped
    ports:
      - '${PORT:-8080}:${PORT:-8080}'
    env_file:
      - .env
    healthcheck:
      test:
        [
          'CMD',
          'node',
          '-e',
          "fetch('http://127.0.0.1:' + (process.env.PORT || 8080)).then(r => { if (!r.ok) process.exit(1) }).catch(() => process.exit(1))",
        ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    depends_on:
      - redis
    networks:
      - app_network

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    networks:
      - app_network

networks:
  app_network:
    driver: bridge
